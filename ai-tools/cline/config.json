{
  "id": "cline",
  "displayName": "Cline",
  "avatar": "🟣",
  "nickname": "Cline",
  "category": "开源社区",
  "website": "https://cline.bot/cli",
  "apiProtocol": "openai",
  "supportModel": true,
  "supportFallbackModel": false,

  "supportsOpenai": true,
  "supportsAnthropic": false,
  "supportsGoogle": false,
  "builtinModels": [],
  "supportsOptimizer": true,
  "supportsRectifier": true,

  "resumeCmd": null,
  "continueCmd": null,
  "dispatchCmd": "cline --json --yolo --provider openai --model {model} {prompt}",
  "dispatchResumeCmd": "cline --json --yolo --provider openai --model {model} --id {session_id} {prompt}",
  "runner": "cline-json",
  "promptMode": "arg",
  "cacheDirs": [".cline"],
  "pkgManager": "npm",
  "pkgName": "cline",
  "configFile": {
    "path": "~/.cline/data/settings/providers.json",
    "format": "json",
    "write": {
      "provider": "openai",
      "apiBase": "baseUrl",
      "apiKey": "apiKey",
      "openAiModelId": "model"
    }
  },
  "sessions": {
    "type": "none"
  },
  "skillsDir": "~/.cline/skills"
}
