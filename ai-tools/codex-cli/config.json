{
  "id": "codex-cli",
  "displayName": "Codex CLI",
  "avatar": "⚡",
  "nickname": "Codex",
  "category": "OpenAI",
  "website": "https://github.com/openai/codex",
  "apiProtocol": "openai",
  "supportModel": true,
  "supportFallbackModel": false,
  "supportsOpenai": true,
  "supportsAnthropic": false,
  "supportsGoogle": false,
  "builtinModels": [
    "gpt-6-astra",
    "gpt-6-sol",
    "gpt-6-luna",
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna",
    "gpt-5.5",
    "gpt-5.3-codex",
    "gpt-5.2-codex",
    "gpt-5.1-codex"
  ],
  "supportsOptimizer": true,
  "supportsPluginMarketplace": true,
  "pluginMarketplaceKind": "codex",
  "supportsRectifier": true,
  "resumeCmd": null,
  "forkCmd": "codex fork {session_id}",
  "continueCmd": "codex resume --last",
  "dispatchCmd": "codex exec --json --full-auto --model {model}",
  "dispatchResumeCmd": "codex exec --json --full-auto --model {model} resume {session_id}",
  "runner": "codex-json",
  "promptMode": "stdin",
  "cacheDirs": [
    ".codex"
  ],
  "pkgManager": "npm",
  "pkgName": "@openai/codex",
  "configFile": {
    "path": "~/.codex/config.toml",
    "format": "toml",
    "write": {
      "model": "model",
      "model_provider": "anyversion",
      "model_providers.anyversion.name": "AnyVersion",
      "model_providers.anyversion.base_url": "baseUrl",
      "model_providers.anyversion.wire_api": "responses",
      "model_providers.anyversion.requires_openai_auth": "boolTrue",
      "env.OPENAI_MODEL": "model",
      "env.CODEX_MODEL": "model",
      "auth.json#OPENAI_API_KEY": "apiKey"
    },
    "removeKeys": [
      "model_providers.anyversion.env_key",
      "web_search",
      "model_reasoning_effort",
      "model_context_window",
      "model_auto_compact_token_limit",
      "model_catalog_json",
      "model_supports_reasoning_summaries",
      "model_reasoning_summary"
    ]
  },
  "sessions": {
    "type": "jsonl",
    "dirs": [
      "~/.codex/sessions.jsonl"
    ]
  },
  "skillsDir": "~/.codex/skills"
}
