{
  "id": "claude-code",
  "displayName": "Claude Code",
  "avatar": "🧠",
  "nickname": "Claude",
  "category": "Anthropic",
  "website": "https://claude.ai/code",
  "apiProtocol": "anthropic",
  "supportModel": true,
  "supportFallbackModel": true,
  "supportsOpenai": false,
  "supportsAnthropic": true,
  "supportsGoogle": false,
  "builtinModels": [
    "claude-opus-5-5",
    "claude-opus-5",
    "claude-sonnet-5",
    "claude-opus-4-8",
    "claude-opus-4-7",
    "claude-opus-4-6",
    "claude-sonnet-4-6",
    "claude-opus-4-5-20251101",
    "claude-sonnet-4-5-20250929",
    "claude-haiku-4-5-20251001"
  ],
  "supportsOptimizer": true,
  "supportsRectifier": true,
  "supportOneMContext": true,
  "resumeCmd": "claude --resume {session_id}",
  "forkCmd": "claude --resume {session_id} --fork-session",
  "continueCmd": "claude --continue",
  "dispatchCmd": "claude -p --output-format stream-json --verbose --dangerously-skip-permissions --permission-mode bypassPermissions --include-partial-messages",
  "dispatchResumeCmd": "claude -p --output-format stream-json --verbose --dangerously-skip-permissions --permission-mode bypassPermissions --include-partial-messages --resume {session_id}",
  "dispatchContinueCmd": "claude --continue -p --output-format stream-json --verbose --dangerously-skip-permissions --permission-mode bypassPermissions --include-partial-messages",
  "runner": "stream-json",
  "promptMode": "stdin",
  "cacheDirs": [
    ".claude"
  ],
  "pkgManager": "npm",
  "pkgName": "@anthropic-ai/claude-code",
  "configFile": {
    "path": "~/.claude/settings.json",
    "format": "json",
    "write": {
      "env.ANTHROPIC_BASE_URL": "baseUrl",
      "env.ANTHROPIC_AUTH_TOKEN": "apiKey",
      "env.ANTHROPIC_MODEL": "model",
      "env.CLAUDE_CODE_SUBAGENT_MODEL": "model",
      "env.API_TIMEOUT_MS": "3000000",
      "env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "fileEnv.ANTHROPIC_BASE_URL": "baseUrl",
      "fileEnv.ANTHROPIC_AUTH_TOKEN": "apiKey",
      "fileEnv.ANTHROPIC_MODEL": "model",
      "fileEnv.ANTHROPIC_DEFAULT_OPUS_MODEL": "model",
      "fileEnv.ANTHROPIC_DEFAULT_SONNET_MODEL": "model",
      "fileEnv.ANTHROPIC_DEFAULT_FABLE_MODEL": "model",
      "fileEnv.ANTHROPIC_DEFAULT_HAIKU_MODEL": "fallbackModel",
      "fileEnv.CLAUDE_CODE_SUBAGENT_MODEL": "model",
      "fileEnv.API_TIMEOUT_MS": "3000000",
      "fileEnv.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
    }
  },
  "sessions": {
    "type": "claude_projects",
    "dirs": [
      "~/.claude/projects"
    ]
  },
  "skillsDir": "~/.claude/skills"
}
