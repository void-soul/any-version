{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyVersion",
  "version": "1.4.0",
  "identifier": "com.voidsoul.anyversion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9999",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnyVersion 开发助理",
        "width": 1150,
        "height": 780,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0d111d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; font-src 'self' data:; media-src 'self' blob: http: https:; frame-src 'self' http: https:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "_up_/ai-tools/*.json",
      "_up_/ai-tools/*/*.json",
      "_up_/projects/*/*.json",
      "_up_/node-projects/*.json"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/void-soul/any-version/releases/latest/download/latest.json"
      ],
      "pubkey": "z4+oE7D31j6Th5tv3nxvftU+drZFePAO+TQyxjyZ4L8="
    }
  }
}
