# AnyVersion 证书接收端配置示例
# 复制为 cert-receiver.toml 并修改；exe 会依次在以下位置查找：
#   1. --config <path>
#   2. exe 同目录 cert-receiver.toml
#   3. 当前工作目录 cert-receiver.toml
#   4. %ProgramData%\Kira\cert-receiver.toml
#   5. C:\certs\cert-receiver.toml

listen_addr = "127.0.0.1:9000"
token = "YOUR_SHARED_TOKEN"

# 证书落盘根目录（Windows 路径用双反斜杠或正斜杠）
output_dir = "C:\\certs"

# 落盘布局：
#   cert   —— <output_dir>/<证书ID>/cert.key + fullchain.cer + cert.cer + chain.cer（默认）
#   domain —— <output_dir>/<域名>/...
#   both   —— 同时按证书 ID 与域名各写一份
#   flat   —— 旧版 <域名>.crt / <域名>.key / <域名>.issuer.crt
layout = "cert"

# API / Docker 拉取接口共享密钥（留空则关闭该接口）
# GET /api/open/getCertificate?apiId=...&certificateId=...&timestamp=...&sign=...
# sign = md5(按字母序排序后的 apiId/apiKey/certificateId/timestamp)
# api_key = "YOUR_API_KEY"

# 重载方式：none | command | nginx | service
reload_mode = "nginx"

# reload_mode=nginx：Nginx 安装目录（含 nginx.exe）与配置文件
nginx_prefix = "C:\\nginx"
nginx_conf = "C:\\nginx\\conf\\nginx.conf"

# reload_mode=command 示例：
# reload_mode = "command"
# reload_command = "C:\\nginx\\nginx.exe -s reload"

# reload_mode=service 示例：
# reload_mode = "service"
# service_name = "nginx"

# 兼容旧版：收到证书后执行的脚本（配置后优先于 reload_mode）
# post_script = "powershell -File C:\\certs\\reload.ps1"
