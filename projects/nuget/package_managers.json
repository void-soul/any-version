[
  {
    "id": "nuget",
    "display_name": "NuGet",
    "built_in": true,
    "install_cmd": null,
    "version_cmd": "nuget help",
    "version_exe": "nuget",
    "cache_detect_cmd": null,
    "cache_default_path": "{home}\\.nuget\\packages",
    "cache_env_var": "NUGET_PACKAGES",
    "cache_set_cmd_template": null,
    "extra_caches": [
      {
        "id": "http-cache",
        "display_name": "NuGet HTTP 缓存",
        "detect_cmd": null,
        "default_path": "{home}\\AppData\\Local\\NuGet\\v3-cache",
        "env_var": "NUGET_HTTP_CACHE_PATH",
        "set_cmd_template": null
      }
    ],
    "data_detect_cmd": null,
    "data_default_path": null,
    "data_env_var": null,
    "data_set_cmd_template": null,
    "proxy_detect_cmd": "nuget config -get http_proxy",
    "proxy_set_cmd_template": "nuget config -set http_proxy=\"{url}\"",
    "proxy_clear_cmd": "nuget config -set http_proxy=\"\"",
    "pkg_list_cmd": "nuget locals all -list",
    "pkg_list_format": null,
    "pkg_upgrade_cmd_template": null,
    "pkg_homepage_template": "https://www.nuget.org/packages/{pkg}",
    "mirror_cmd_template": "nuget sources update -name \"nuget.org\" -source \"{url}\"",
    "mirror_detect_cmd": "nuget sources list",
    "mirror_config_desc": "通过 nuget sources 或 NuGet.Config 修改源地址",
    "mirror_options": [
      {
        "mirror_type": "official",
        "name": "官方源 (nuget.org)",
        "url": "https://api.nuget.org/v3/index.json"
      },
      {
        "mirror_type": "huawei",
        "name": "华为云镜像源",
        "url": "https://mirrors.huaweicloud.com/repository/nuget/v3/index.json"
      },
      {
        "mirror_type": "tencent",
        "name": "腾讯云镜像源",
        "url": "https://mirrors.cloud.tencent.com/nuget/"
      }
    ],
    "cache_config_source": {
      "parser_type": "xml",
      "env_vars": [
        "NUGET_PACKAGES"
      ],
      "paths": [
        "{home}\\AppData\\Roaming\\NuGet\\NuGet.Config"
      ],
      "keys": [
        "<add\\s+key\\s*=\\s*\"globalPackagesFolder\"\\s+value\\s*=\\s*\"([^\"]+)\""
      ],
      "write_keys": [
        {
          "key": "globalPackagesFolder",
          "value_suffix": "packages"
        },
        {
          "key": "httpCachePath",
          "value_suffix": "v3-cache"
        },
        {
          "key": "pluginsCachePath",
          "value_suffix": "plugins-cache"
        }
      ]
    }
  }
]
