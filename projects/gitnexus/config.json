{
  "id": "gitnexus",
  "display_name": "GitNexus",
  "category": "tool",
  "official_website": "https://github.com/abhigyanpatwari/GitNexus",
  "bin_dirs": [
    "node_modules/.bin"
  ],
  "has_cache": false,
  "cache_detect_cmd": null,
  "cache_default_path": null,
  "has_mirror": false,
  "mirror_options": null,
  "has_pkg": false,
  "pkg_manager": null,
  "pkg_homepage_template": null,
  "is_service": false,
  "simple_mode": false,
  "default_port": null,
  "data_dir": null,
  "log_dir": null,
  "config_file": null,
  "start_cmd": null,
  "stop_cmd": null,
  "service_process_exes": [
    "gitnexus"
  ],
  "service_names": [],
  "service_start_mode": "detached",
  "service_allow_force_kill": true,
  "service_auto_create_dirs": false,
  "version_cmd": "gitnexus --version",
  "version_exe": "gitnexus",
  "version_parse_regex": "(\\d+\\.\\d+\\.\\d+)",
  "npm_pkg_name": "gitnexus",
  "download_url_template": null,
  "download_file_ext": null,
  "extract_subdir": null,
  "remote_versions_url": "https://registry.npmjs.org/gitnexus",
  "remote_versions_config": {
    "type": "json_api",
    "response_type": "object_keys",
    "array_field": "versions",
    "version_field": "version",
    "filter_contains_not": "-",
    "sort_by_version": true,
    "reverse": true
  },
  "user_configurable_vars": [],
  "post_install": null
}